@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

' --- CONTROLLERS ---

class AuthController {
  - authService: AuthService
  - tokenBlacklistService: TokenBlacklistService
  - jwtTokenProvider: JwtTokenProvider
  + login(LoginRequest): ResponseEntity<ApiResponse<AuthResponse>>
  + logout(String): ResponseEntity<ApiResponse<Void>>
}

class UserController {
  - userService: UserService
  + getAllUsers(): ResponseEntity<ApiResponse<List<UserResponse>>>
  + createUser(CreateUserRequest): ResponseEntity<ApiResponse<UserResponse>>
  + updateUser(String, UpdateUserRequest): ResponseEntity<ApiResponse<UserResponse>>
}

' --- SERVICES & IMPLEMENTATIONS ---

interface AuthService << interface >> {
  + login(LoginRequest): AuthResponse
}

class AuthServiceImpl {
  - authenticationManager: AuthenticationManager
  - tokenProvider: JwtTokenProvider
  + login(LoginRequest): AuthResponse
}

interface UserService << interface >> {
  + getAllUsers(): List<UserResponse>
  + createUser(CreateUserRequest): UserResponse
  + updateUser(UUID, UpdateUserRequest): UserResponse
}

class UserServiceImpl {
  - userRepository: UserRepository
  - roleRepository: RoleRepository
  - passwordEncoder: PasswordEncoder
  + getAllUsers(): List<UserResponse>
  + createUser(CreateUserRequest): UserResponse
  + updateUser(UUID, UpdateUserRequest): UserResponse
}

class UserDetailsServiceImpl {
  - userRepository: UserRepository
  + loadUserByUsername(String): UserDetails
}

' --- SECURITY & FILTERS ---

class JwtTokenProvider {
  - key: SecretKey
  - expirationMs: long
  + generateToken(Authentication): String
  + getUsernameFromToken(String): String
  + validateToken(String): boolean
  + getExpirationMs(): long
}

class JwtAuthenticationFilter {
  - tokenProvider: JwtTokenProvider
  - userDetailsService: UserDetailsService
  - tokenBlacklistService: TokenBlacklistService
  - AUTHORIZATION_HEADER: String
  - BEARER_PREFIX: String
  # doFilterInternal(HttpServletRequest, HttpServletResponse, FilterChain): void
  - parseJwt(HttpServletRequest): String
}

class SecurityConfig {
  - jwtAuthenticationFilter: JwtAuthenticationFilter
  + securityFilterChain(HttpSecurity): SecurityFilterChain
  + corsConfigurationSource(): CorsConfigurationSource
  + passwordEncoder(): PasswordEncoder
  + authenticationManager(AuthenticationConfiguration): AuthenticationManager
}

class TokenBlacklistService {
  - jwtTokenProvider: JwtTokenProvider
  - revokedTokens: Map<String, Instant>
  + revoke(String): void
  + isRevoked(String): boolean
  - purgeExpired(): void
}

' --- REPOSITORIES ---

interface UserRepository << interface >> {
  + findByUsernameWithRolesAndPermissions(String): Optional<User>
}

interface RoleRepository << interface >> {
  + findByName(String): Optional<Role>
}

' --- DTOS & RECORDS ---

record AuthResponse << record >> {
  - token: String
  - tokenType: String
  - username: String
  - expiresIn: Long
  + of(String, String, Long): AuthResponse
}

record LoginRequest << record >> {
  - username: String
  - password: String
}

record CreateUserRequest << record >> {
  - username: String
  - password: String
  - enabled: Boolean
  - role: String
}

record UpdateUserRequest << record >> {
  - role: String
  - enabled: Boolean
}

record UserResponse << record >> {
  - id: UUID
  - username: String
  - enabled: Boolean
  - role: String
  - createdAt: LocalDateTime
}

record CustomUserDetails << record >> {
  - userId: UUID
  - username: String
  - passwordHash: String
  - enabled: boolean
  - authorities: Set<GrantedAuthority>
  - extractAuthorities(User): Set<GrantedAuthority>
}

' --- DOMAIN ENTITIES ---

entity User << Table: users >> {
  - id: UUID <<PK>>
  - username: String <<UQ, Not Null>>
  - passwordHash: String <<Not Null>>
  - enabled: Boolean <<Not Null>>
  - createdAt: LocalDateTime <<Not Null>>
  - roles: Set<Role>
  + getRolesAsString(): String
}

entity Role << Table: roles >> {
  - id: Long <<PK, AutoIncrement>>
  - name: String <<UQ, Not Null>>
  - description: String
  - permissions: Set<Permission>
}

entity Permission << Table: permissions >> {
  - id: Long <<PK, AutoIncrement>>
  - name: String <<UQ, Not Null>>
  - description: String
}

' --- EXTERNAL INTERFACES ---

interface UserDetailsService << interface >> {
  + loadUserByUsername(String): UserDetails
}

interface UserDetails << interface >> {
}

interface JpaRepository << interface >> {
}

' --- RELATIONSHIPS & ASSOCIATIONS ---

' Controller Injections
AuthController          "1" --> "1" AuthService             : authService
AuthController          "1" --> "1" TokenBlacklistService   : tokenBlacklistService
AuthController          "1" --> "1" JwtTokenProvider        : jwtTokenProvider
UserController          "1" --> "1" UserService             : userService

' Service & Security Injections
AuthServiceImpl         "1" --> "1" JwtTokenProvider        : tokenProvider
UserServiceImpl         "1" --> "1" UserRepository          : userRepository
UserServiceImpl         "1" --> "1" RoleRepository          : roleRepository
JwtAuthenticationFilter "1" --> "1" JwtTokenProvider        : tokenProvider
JwtAuthenticationFilter "1" --> "1" UserDetailsService      : userDetailsService
JwtAuthenticationFilter "1" --> "1" TokenBlacklistService   : tokenBlacklistService
SecurityConfig          "1" --> "1" JwtAuthenticationFilter : jwtAuthenticationFilter
TokenBlacklistService   "1" --> "1" JwtTokenProvider        : jwtTokenProvider
UserDetailsServiceImpl "1" --> "1" UserRepository          : userRepository

' Interface Realizations
AuthServiceImpl        ..|> AuthService
UserServiceImpl        ..|> UserService
UserDetailsServiceImpl ..|> UserDetailsService
CustomUserDetails      ..|> UserDetails
UserRepository         --|> JpaRepository
RoleRepository         --|> JpaRepository

' Junction Tables & Database Mappings
User "1" *-- "*" Role : user_roles\n(user_id <<FK>>, role_id <<FK>>) >
Role "1" *-- "*" Permission : role_permissions\n(role_id <<FK>>, permission_id <<FK>>) >

' Behavioral Dependencies
AuthController          ..> LoginRequest      : uses
AuthController          ..> AuthResponse      : returns
UserController          ..> CreateUserRequest : uses
UserController          ..> UpdateUserRequest : uses
UserController          ..> UserResponse      : returns
AuthService             ..> LoginRequest      : accepts
AuthService             ..> AuthResponse      : returns
UserService             ..> CreateUserRequest : accepts
UserService             ..> UpdateUserRequest : accepts
UserService             ..> UserResponse      : returns
UserDetailsServiceImpl  ..> UserRepository    : queries
UserRepository          ..> User              : retrieves
RoleRepository          ..> Role              : retrieves
CustomUserDetails       ..> User              : constructs from

@enduml